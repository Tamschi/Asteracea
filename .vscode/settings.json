{
	"rust-analyzer.procMacro.enable": true,
	"todo-tree.general.tags": [
		"BUG",
		"HACK",
		"FIXME",
		"TODO",
		"XXX",
		"todo!"
	],
	"todo-tree.regex.regex": "(($TAGS)|^\\s*- \\[ \\])",
	"rust-analyzer.cargo.buildScripts.enable": true,
	"cSpell.words": [
		"ascii",
		"asteracea",
		"preprocess",
		"punct",
		"Punct",
		"Schichler",
		"Tamme"
	],
	"git.enabled": false
}